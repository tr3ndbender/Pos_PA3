<Window x:Class="WaldwunderDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WaldwunderDB"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*">
            </ColumnDefinition>
            <ColumnDefinition Width="*">
            </ColumnDefinition>
            <ColumnDefinition Width="4*">
            </ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="10*"></RowDefinition>
        </Grid.RowDefinitions>

        <Button x:Name="WaldwunderButton" Click="WaldwunderButton_Click" Margin="5" Grid.Row="0" Grid.Column="0">Neues Waldwunder</Button>
        <Button x:Name="AnzeigenButton" Click="AnzeigenButton_Click" Margin="5" Grid.Row="0" Grid.Column="1">Waldwunder Anzeigen</Button>

        <ListBox x:Name="Waldwunder" ItemsSource="{Binding WaldwunderItems}" Grid.Row="1" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding Name}"></TextBlock>
                        <TextBlock Text="{Binding Description}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Canvas x:Name="Map" Grid.Row="1" Grid.Column="2">
            <Canvas.Background>
                <ImageBrush ImageSource="blobid0.png" Stretch="Fill"></ImageBrush>
            </Canvas.Background>
        </Canvas>
    </Grid>
</Window>

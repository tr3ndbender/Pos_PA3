<Window x:Class="Austrian_Painter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:painter="clr-namespace:Painter;assembly=Painter"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Austrian_Painter"
        mc:Ignorable="d"
        Title="Austrian Painter" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Button Click="Button_Click">Run</Button>
        <TextBox x:Name="Code" Grid.Row="1" AcceptsReturn="True"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto"></TextBox>
        <TextBlock Grid.Column="1">Tokens</TextBlock>
        <ListBox x:Name="TokensList" Grid.Row="1" Grid.Column="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Type}" Margin="5" Width="100"></TextBlock>
                        <TextBlock Text="{Binding Value}" Margin="5"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <painter:PainterControl x:Name="Field" Grid.Column="2" Grid.Row="1"/>
    </Grid>
</Window>

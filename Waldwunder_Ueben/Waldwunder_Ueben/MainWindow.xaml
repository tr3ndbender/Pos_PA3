<Window x:Class="Waldwunder_Ueben.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Waldwunder_Ueben"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="3*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <ListBox ItemsSource="{Binding Path=waldwunders}" Grid.Column="0" SelectionChanged="ListBox_SelectionChanged" x:Name="wunderListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}"></TextBlock>
                        <TextBlock Text="{Binding Description}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    
        <StackPanel Grid.Column="1" Margin="10" x:Name="detailStackPanel" Visibility="Collapsed">
            <TextBlock x:Name="DetailName" ></TextBlock>
            <TextBlock x:Name="Description" ></TextBlock>
            <TextBlock x:Name="Province" ></TextBlock>
            <TextBlock x:Name="Latitude" ></TextBlock>
            <TextBlock x:Name="Longitude" ></TextBlock>
            <TextBlock x:Name="Votes" ></TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300" Margin="0,10,0,0">
                <ItemsControl x:Name="BilderItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel></WrapPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Height="150" Margin="5" Stretch="Uniform"></Image>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
        <Canvas x:Name="mapCanvas" Grid.Column="1">
            <Canvas.Background>
                <ImageBrush ImageSource="map.png" Stretch="Fill"></ImageBrush>
            </Canvas.Background>
        </Canvas>
    </Grid>
</Window>

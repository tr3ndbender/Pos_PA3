<Window x:Class="Waldwunder_Verwaltung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Waldwunder_Verwaltung"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Loaded="Window_Loaded">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="NewWonder_Executed" CanExecute="NewWonder_CanExecute"></CommandBinding>
        <CommandBinding Command="Properties" Executed="Anzeigen_Executed" CanExecute="Anzeigen_CanExecute"></CommandBinding>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Neues Waldwunder" Command="New" />
            <MenuItem Header="_Anzeigen" Command="Properties"/>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" Name="lbWaldwunder">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Name}"></TextBlock>
                            <TextBlock Text="{Binding Description}"></TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
            <!-- Neues Waldwunder Dialog -->
            <Grid Name="dialog" Grid.Column="1" Visibility="Collapsed" Margin="40" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Name"></TextBlock>
                    <TextBox Name="tbName"></TextBox>

                    <TextBlock Text="Description"></TextBlock>
                    <TextBox Name="tbDescription"></TextBox>

                    <TextBlock Text="Province"></TextBlock>
                    <TextBox Name="tbProvince"></TextBox>

                    <TextBlock Text="Latitude"></TextBlock>
                    <TextBox Name="tbLatitude"></TextBox>

                    <TextBlock Text="Longitude"></TextBlock>
                    <TextBox Name="tbLongitude"></TextBox>

                    <TextBlock Text="Type"></TextBlock>
                    <TextBox Name="tbType"></TextBox>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Registrieren" Margin="0,0,40,0" Click="Register_Click"></Button>
                    <Button Content="Abbrechen" Click="Cancel_Click"/>
                </StackPanel>
                <Button Grid.Column="2" Grid.Row="1" Content="Bild hinzufügen" Margin="40,0,40,0" Click="btnOpenFile_Click"></Button>


                <StackPanel Grid.Column="2">
                    <TextBlock Text="Image Files"></TextBlock>
                    <ListBox Name="lbImages" Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding .}"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
            
            <!-- Anzeigen Dialog -->
            <Grid Name="showDialog" Grid.Column="1" Visibility="Collapsed" Margin="40"
                  DataContext="{Binding ElementName=lbWaldwunder, Path=SelectedItem}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="8*"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="6*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}"></TextBlock>
                    <TextBlock Text="{Binding Description}"></TextBlock>
                    <TextBlock Text="{Binding Province}"></TextBlock>
                    <TextBlock Text="{Binding Latitude}"></TextBlock>
                    <TextBlock Text="{Binding Longitude}"></TextBlock>
                    <TextBlock Text="{Binding Type}"></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Abbrechen" Click="Cancel_Click"/>
                </StackPanel>
                <Button Grid.Column="2" Grid.Row="1" Content="Bild hinzufügen" Margin="40,0,40,0" Click="btnOpenFile_Click"></Button>


                <StackPanel Grid.Column="2">
                    <TextBlock Text="Image Files"></TextBlock>
                    <ListBox ItemsSource="{Binding ImagePaths}" Padding="5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding .}"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <Canvas x:Name="mapCanvas" Grid.Column="1" SizeChanged="mapCanvas_SizeChanged">
                <Canvas.Background>
                    <ImageBrush ImageSource="map.png" Stretch="Fill"></ImageBrush>
                </Canvas.Background>
            </Canvas>
        </Grid>
    </DockPanel>
</Window>

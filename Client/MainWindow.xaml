<Window x:Class="Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Client"
        mc:Ignorable="d"
        Title="3. praktische Arbeit" Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Zeile 0: Namenssuche -->
            <RowDefinition Height="Auto"/>  <!-- Zeile 1: Suchen (Filter) -->
            <RowDefinition Height="Auto"/>  <!-- Zeile 2: Suchen-Button -->
            <RowDefinition Height="Auto"/>  <!-- Zeile 3: Gefundene Namen -->
            <RowDefinition Height="Auto"/>  <!-- Zeile 4: Alternativen -->
            <RowDefinition Height="*"/>     <!-- Zeile 5: ListBoxen -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>   <!-- Links: Labels -->
            <ColumnDefinition Width="*"/>   <!-- Rechts: Eingaben -->
        </Grid.ColumnDefinitions>

        <!-- Zeile 0 -->
        <Label    Grid.Row="0" Grid.Column="0" Content="Namenssuche" VerticalAlignment="Center"/>
        <TextBox  x:Name="namensSucheTB" Grid.Row="0" Grid.Column="1" Margin="0,4"/>

        <!-- Zeile 1 -->
        <Label    Grid.Row="1" Grid.Column="0" Content="Suchen" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" x:Name="GenderComboBox">
            <ComboBoxItem Content="maennlich" Tag="M"/>
            <ComboBoxItem Content="weiblich" Tag="W"/>
        </ComboBox>

        <!-- Zeile 2 -->
        <Button   x:Name="suchButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  Content="Suchen" Margin="0,4" Click="suchButton_Click"/>

        <!-- Zeile 3 -->
        <Label    Grid.Row="3" Grid.Column="0" Content="Gefundene Namen" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" Name="FoundNamesComboBox" ItemsSource="{Binding FoundNames}" SelectionChanged="FoundNamesComboBox_SelectionChanged"/>

        <!-- Zeile 4 -->
        <Label    Grid.Row="4" Grid.Column="0" Content="Alternativen" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" Name="AlternativeNamesComboBox" SelectionChanged="AlternativeNamesComboBox_SelectionChanged" RenderTransformOrigin="0.5,0.5">
            <ComboBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0.21"/>
                    <TranslateTransform/>
                </TransformGroup>
            </ComboBox.RenderTransform>
        </ComboBox>

        <!-- Zeile 5: ListBoxen -->
        <ListBox  x:Name="GroupByYearListBox"     Grid.Row="5" Grid.Column="0" Margin="0,4,5,0"/>
        <ListBox  x:Name="anzListBox" Grid.Row="5" Grid.Column="1" Margin="5,4,0,0"/>

    </Grid>
</Window>
